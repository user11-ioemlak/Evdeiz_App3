{
  "expo": {
    "name": "Evdeiz",
    "slug": "evdeiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.evdeiz.app",
      "infoPlist": {
        "CFBundleDisplayName": "Evdeiz",
        "CFBundleIconName": "AppIcon",
        "CFBundleIcons": {
          "CFBundlePrimaryIcon": {
            "CFBundleIconFiles": [
              "AppIcon60x60"
            ],
            "UIPrerenderedIcon": false
          },
          "CFBundleAlternateIcons": {
            "19Mayis": {
              "CFBundleIconFiles": [
                "19Mayis60x60"
              ],
              "UIPrerenderedIcon": false
            }
          }
        },
        "CFBundleIcons~ipad": {
          "CFBundlePrimaryIcon": {
            "CFBundleIconFiles": [
              "AppIcon60x60",
              "AppIcon76x76"
            ],
            "UIPrerenderedIcon": false
          },
          "CFBundleAlternateIcons": {
            "19Mayis": {
              "CFBundleIconFiles": [
                "19Mayis60x60",
                "19Mayis76x76"
              ],
              "UIPrerenderedIcon": false
            }
          }
        },
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.evdeiz.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "appVariant": "production",
      "githubRepo": "user13ioemlak/Evdeiz_App3",
      "buildEnv": "live",
      "buildUrl": "https://ioemlak.com/",
      "appSecretToken": "Evdeiz_Secure_App_Key_2026_x87f",
      "customUserAgentPrefix": "EvdeizApp",
      "disableZoom": true,
      "iconCampaignUrl": "https://ioemlak.com/app_icon/config.json"
    },
    "plugins": [
      "./plugins/withAndroidActivityAliases"
    ]
  }
}
